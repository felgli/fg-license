# =============================================================================
# RSA key pair — generate with: node scripts/generate-keys.mjs
# =============================================================================

# RSA private key for signing JWTs (PEM, base64-encoded)
JWT_PRIVATE_KEY_B64=

# RSA public key for verifying JWTs (PEM, base64-encoded)
JWT_PUBLIC_KEY_B64=

# =============================================================================
# Customer registry
# JSON array of customer objects. secretHash is optional.
#
# Without secretHash: any caller knowing customerId gets a token (open/internal).
# With secretHash:    apiSecret is required (hash it with scripts/generate-keys.mjs).
#
# Example:
# [
#   {"id":"customerA","features":["analytics","export"]},
#   {"id":"customerB","secretHash":"<sha256-hex>","features":["export"],"name":"Acme Corp"}
# ]
# =============================================================================
CUSTOMER_REGISTRY=

# =============================================================================
# App URL (used in JWT iss claim and docs page)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Optional: Upstash Redis for distributed rate limiting across Vercel instances.
# If not set, falls back to in-memory rate limiting (fine for single-instance dev).
# =============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
